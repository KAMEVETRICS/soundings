# Required for live market data
RYO_MCP_URL=https://app-ryochan.com/api/mcp
RYO_MCP_KEY=

# Optional. Claw answers from RYO evidence via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAMBER_MODEL=x-ai/grok-4.3

# Optional. Independent Fear & Greed / MVRV on /analytics only.
TRUENORTH_MCP_URL=https://mcp.true-north.xyz/mcp
TRUENORTH_MCP_TOKEN=

# Seconds to reuse a successful RYO tool response
RYO_CACHE_TTL=180
# Serve last-good while a refresh runs (seconds)
RYO_SWR_TTL=900
