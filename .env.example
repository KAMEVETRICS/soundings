# Required for live market data
RYO_MCP_URL=https://app-ryochan.com/api/mcp
RYO_MCP_KEY=

# Optional. Claw answers from RYO evidence via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAMBER_MODEL=x-ai/grok-4.3

# Optional. Independent Fear & Greed / MVRV on /analytics only.
TRUENORTH_MCP_URL=https://mcp.true-north.xyz/mcp
TRUENORTH_MCP_TOKEN=

# Seconds to reuse a successful RYO tool response
RYO_CACHE_TTL=180
# Serve last-good while a refresh runs (seconds)
RYO_SWR_TTL=900
# Last-good data may stand in for a failed RYO reply for this long (seconds, 48h)
RYO_LASTGOOD_TTL=172800
# Delete cache files older than this (seconds, 7d)
CACHE_MAX_AGE=604800

# Per-IP limits (see README "Limits")
RATE_LIMIT_PER_MIN=120
TOKEN_LIMIT_PER_MIN=12
CLAW_LIMIT_PER_MIN=4
CLAW_DAILY_LIMIT=300
UNKNOWN_TICKER_TTL=3600
